# Public, local-only development credentials. Never use these for deployment.
RUST_LOG=info
DATABASE_URL=sqlite:/workspaces/aur-builder/.devcontainer/state/dev.sqlite?mode=rwc
AB_CONFIG_PATH=/workspaces/aur-builder/.devcontainer/config.yaml
AMQP_ADDR=amqp://builder:dev-rabbitmq-password@rabbitmq:5672/%2f
AB_WEB_URL=https://aur.localhost:8443
AB_OIDC_ISSUER=https://auth.localhost:8443/realms/aur-builder
AB_OIDC_CLIENT_ID=aur-builder
AB_OIDC_CLIENT_SECRET=dev-oidc-secret
AB_OIDC_GROUPS_CLAIM=groups
AB_OIDC_ADMIN_GROUP=aur-builder-admins
AB_OIDC_SCOPES=profile email
AB_SESSION_SECONDS=3600
AB_AI_MODE=disabled
AB_S3_ENDPOINT=http://garage:3900
AB_S3_PUBLIC_ENDPOINT=https://s3.localhost:8443
AB_S3_BUCKET=aur-builder-dev
AB_S3_REGION=garage
AB_S3_ACCESS_KEY=GK0123456789abcdef01234567
AB_S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AB_UPLOAD_TTL=86400
AB_SMTP_HOST=mailpit
AB_SMTP_USER=builder
AB_SMTP_PASS=dev-mail-password
AB_SMTP_FROM=builder@example.test
AB_SMTP_TO=developer@example.test
AB_MAILLOGO=https://aur.localhost:8443/favicon.ico
TEST_POSTGRESQL_URL=postgresql://builder:dev-postgres-password@postgres:5432/aur_builder_test
PRISMA_POSTGRESQL_URL=postgresql://builder:dev-postgres-password@postgres:5432/aur_builder_schema
PRISMA_SQLITE_URL=file:/workspaces/aur-builder/.devcontainer/state/schema.sqlite
