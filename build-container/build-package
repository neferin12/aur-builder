#! /bin/bash

set -euo pipefail

: "${AB_UPLOAD_URL:?missing task upload URL}"

get-source

cd ~/source || exit 100

if [[ -n "$AB_SUBFOLDER" ]]; then
    cd "$AB_SUBFOLDER" || exit 100
fi


install-dependencies

timestamp=$(date +%s)
logfile="/build/$timestamp-build.log"

makepkg -s -c -C --noconfirm --noprogressbar ${AB_OPTIONS:-} | tee "$logfile" || exit 105
shopt -s nullglob
packages=()
for package in ./*.pkg.tar.*; do
    [[ "$package" == *.sig ]] && continue
    packages+=("$package")
done
[ "${#packages[@]}" -gt 0 ] || exit 106
cp -- "${packages[@]}" /results || exit 106
cp "$logfile" /results || exit 106

shopt -s nullglob
packages=(/results/*.pkg.tar.*)
[ "${#packages[@]}" -gt 0 ] || exit 106
(cd /results && tar -cf /build/bundle.tar -- ./*.pkg.tar.*) || exit 106
# Do not print the URL: it grants access to this object.
status=$(curl --silent --output /dev/null --write-out '%{http_code}' --upload-file /build/bundle.tar "$AB_UPLOAD_URL") || exit 107
[[ "$status" == 200 || "$status" == 201 || "$status" == 204 ]] || exit 107
