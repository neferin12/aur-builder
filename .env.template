# Interactive provisioning: ./setup.py
RUST_LOG=info
DATABASE_URL=sqlite:/app/db/sqlite.db?mode=rwc
AB_CONFIG_PATH=./config.yaml

# Set these before the first RabbitMQ startup. Percent-encode AMQP URL credentials.
RABBITMQ_DEFAULT_USER=builder
RABBITMQ_DEFAULT_PASS=
# Run python3 scripts/provision_broker.py to create scoped service accounts.
# AMQP_ADDR is only for standalone development commands, not Compose services.
AMQP_ADDR=amqp://builder:REPLACE_PASSWORD@localhost:5672/%2f

# Private Garage storage. Setup provisions the bucket and access key.
GARAGE_RPC_SECRET=
AB_S3_ENDPOINT=http://garage:3900
# Must be reachable from build containers and pacman clients.
AB_S3_PUBLIC_ENDPOINT=https://storage.example.com
AB_S3_BUCKET=aur-builder
AB_S3_REGION=garage
AB_S3_ACCESS_KEY=
AB_S3_SECRET_KEY=
AB_UPLOAD_TTL=900
# Generated by scripts/provision_broker.py; shared only by worker and repo.
AB_ARTIFACT_KEY=

# Authenticated, GPG-signed pacman repository.
AB_REPO_USER=builder
AB_REPO_PASSWORD=
AB_REPO_NAME=aur-builder
AB_REPO_GPG_KEY=
AB_DOWNLOAD_TTL=900
AB_REPO_MAX_BYTES=4294967296

# Build memory and filesystem ceilings (MiB), per concurrent build.

# Omit memory/disk overrides to size them from Docker host memory.
# AB_BUILD_MEMORY_MIB=8192
# AB_BUILD_DISK_MIB=6144
AB_BUILD_OUTPUT_MIB=1024
AB_BUILD_TIMEOUT_SECONDS=14400

# Optional worker image overrides. Setup can build a local image automatically.
# AB_BUILDER=your-registry/aur-builder-build-container
# AB_BUILDER_TAG=your-tag

# Optional notifier configuration; leave notifier stopped until configured.
# AB_SMTP_HOST=smtp.example.com
# AB_SMTP_USER=builder@example.com
# AB_SMTP_PASS=
# AB_SMTP_FROM=builder@example.com
# AB_SMTP_TO=you@example.com
# AB_MAILLOGO=https://example.com/logo.png

# Mandatory web UI single sign-on. Register the callback as AB_WEB_URL/auth/callback.
AB_WEB_URL=https://builder.example.com
AB_OIDC_ISSUER=https://identity.example.com/realms/builder
AB_OIDC_CLIENT_ID=aur-builder
AB_OIDC_CLIENT_SECRET=
AB_OIDC_GROUPS_CLAIM=groups
AB_OIDC_SCOPES=profile
AB_OIDC_ADMIN_GROUP=aur-builder-admins
AB_SESSION_SECONDS=3600

# Optional OpenAI packaging review: disabled, feedback, or auto_approve.
AB_AI_MODE=disabled
# Required when AI is enabled. Select a model that supports JSON Schema output.
# AB_AI_MODEL=
# OPENAI_API_KEY=
AB_AI_MAX_BYTES=200000
AB_AI_TIMEOUT_SECONDS=90

# Optional exact proxy IPs/CIDRs allowed to supply X-Forwarded-For. Empty trusts none.
AB_TRUSTED_PROXIES=

# Local Docker socket path and group are discovered by provision_build_network.py.
# For a rootless engine set DOCKER_SOCKET_PATH to its Unix socket before provisioning.
